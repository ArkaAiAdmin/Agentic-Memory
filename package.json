{
  "name": "agentic-memory-ide",
  "version": "0.1.0",
  "private": true,
  "description": "Memory-First Agent IDE — agentic-memory is the kernel",
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "verify:fast": "node scripts/verify.mjs --fast",
    "typecheck": "pnpm --dir ide typecheck && ./venv/bin/mypy --config-file pyproject.toml",
    "lint": "./venv/bin/ruff check . --config pyproject.toml && pnpm --dir ide lint",
    "test": "make test-quick && pnpm --dir ide test",
    "test:coverage": "node scripts/test-coverage-unified.mjs",
    "update-docs": "make update-docs",
    "clean": "pnpm --dir ide clean"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.11.0",
    "vitest": "^4.1.10"
  }
}
