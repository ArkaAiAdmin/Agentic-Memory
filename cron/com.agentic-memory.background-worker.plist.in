<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.agentic-memory.background-worker</string>

    <!--
      Drain-mode background worker daemon for agentic-memory.
      Runs background_worker.py in --drain mode (process up to 50 tasks
      and exit), with launchd restarting it every 300 seconds.  The cron
      scheduler also runs --drain every 5 min via a separate lock name
      ("background_worker_drain"), so both paths coexist without contention.

      Replaced the old --interval=N persistent mode which held the
      background_worker flock permanently, starving all cron drain ticks
      and blocking enqueue_task.py inserts while a slow task was processing.

      Installed by cron/install_launchagent.sh (fills __ROOT__).
    -->

    <key>ProgramArguments</key>
    <array>
        <string>__VENV_PY__</string>
        <string>__ROOT__/background/background_worker.py</string>
        <string>--drain</string>
        <string>--max-tasks=50</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>MEMORY_DB_PATH</key>
        <string>__DB_PATH__</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <key>PYTHONPATH</key>
        <string>__ROOT__</string>
        <!--
          Must match the token configured in memory.toml [api] token.
          Sync-client subprocesses spawned by the worker need this to
          authenticate against the sync-opencode / sync-mimocode servers.
        -->
        <key>MEMORY_API_TOKEN</key>
        <string>__SYNC_TOKEN__</string>
    </dict>

    <!--
      KeepAlive on successful exit: --drain processes up to max-tasks and
      then exits 0.  ThrottleInterval=300 prevents busy-looping: launchd
      waits 300s (5 min) before restarting, matching the cron scheduler's
      --drain cadence.  On crash (non-zero exit) launchd retries faster
      per the default ThrottleInterval.
    -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <true/>
        <key>ThrottleInterval</key>
        <integer>300</integer>
    </dict>

    <!-- Start at login (and after a crash). -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__LOG_DIR__/background_worker.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/background_worker.launchd.log</string>
</dict>
</plist>
